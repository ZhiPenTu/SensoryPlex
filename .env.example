# Run `make configure` to create .env with random credentials; do not commit .env.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_SECRET
POSTGRES_PORT=25432
SENSORYPLEX_DATABASE_URL=postgresql://sensoryplex:REPLACE_WITH_RANDOM_URL_SAFE_SECRET@127.0.0.1:25432/sensoryplex
SENSORYPLEX_API_TOKEN=REPLACE_WITH_RANDOM_API_TOKEN
SENSORYPLEX_PRINCIPAL=local-developer
GATEWAY_PORT=8090
NATS_PORT=24222
SENSORYPLEX_RUNTIME_ADDR=127.0.0.1:50051
RUST_LOG=info
MINIO_ROOT_USER=sensoryplex-local
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_MINIO_SECRET

CONSOLE_PORT=5173
API_PORT=8091

# 文档站（apps/docs，纯静态 VitePress；./deploy/up.sh 会一并拉起它）。
# DOCS_PORT 是站点入口；DOCS_DEV_PORT 只在 `make docs-dev` / `make docs-serve` 开发期使用
# （两者互斥——同一个端口不能同时被 dev 与 preview 占用）。
DOCS_PORT=5174
DOCS_DEV_PORT=5175
# DOCS_SITE_URL 会随镜像构建注入（它只增加 sitemap 与绝对地址）。留空表示“尚未发布到公网”，
# 此时不产出 sitemap，也不编造域名。设置后重建：./deploy/up.sh docs
DOCS_SITE_URL=
# 子路径托管（例如 GitHub Pages 项目页）**不从 .env 读**：本机 docs 服务始终按根路径托管，
# 注入前缀会让整站 404。要产出子路径产物请从命令行传入构建期前缀：
#   make docs-build DOCS_BASE=/your-prefix/

# 事件链路常驻（./deploy/up-events.sh 的 relay / index 服务，ADR-027）。
# 分级上限是准入上限；两个批深度（relay 每轮认领 / 消费在飞未 ack）**必须 <= 上限**，
# 否则服务在连任何东西之前就按 `event_inflight_exceeds_tier_cap` 拒绝启动（不夹取、不降级）。
# 档位数值的参考口径见 tools/macos_resident.py 的分级表（主机 launchd 那一份）。
SENSORYPLEX_RESIDENT_TIER=medium
SENSORYPLEX_EVENT_QUEUE_CAPACITY=32
SENSORYPLEX_EVENT_RELAY_BATCH=16
SENSORYPLEX_EVENT_CONSUME_BATCH=32

# 常驻索引检索面（ADR-023）：容器内是 compose 服务名 `index:50077`（api 容器由 compose 覆写）。
# 下面两个名字是**同一个**令牌——检索面读 AUTH_TOKEN，api 读 SEARCH_TOKEN，长度必须 >= 32。
SENSORYPLEX_INDEX_SEARCH_ENDPOINT=index:50077
SENSORYPLEX_INDEX_AUTH_TOKEN=REPLACE_WITH_RANDOM_INDEX_TOKEN
SENSORYPLEX_INDEX_SEARCH_TOKEN=REPLACE_WITH_RANDOM_INDEX_TOKEN
SENSORYPLEX_INDEX_VECTOR_INDEX_KEY=material_text_bge_small_zh_v1_5_d512_v1

# bind mount 与开发验证入口。
REPO_ROOT=/absolute/path/to/SensoryPlex
MEDIA_DIR=/absolute/path/to/authorized-media
SENSORYPLEX_TEST_DATABASE_URL=postgresql://sensoryplex:REPLACE_WITH_RANDOM_URL_SAFE_SECRET@postgres:5432/sensoryplex_test

# 演示账号（make demo-seed 自动生成并写入 .env）。
SENSORYPLEX_DEMO_USERNAME=demo
SENSORYPLEX_DEMO_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
